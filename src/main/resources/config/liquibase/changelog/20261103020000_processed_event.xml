<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20261103020000-1" author="zoe">
        <comment>Eventos de Kafka ya procesados, para ignorar mensajes duplicados.</comment>
        <createTable tableName="processed_event">
            <column name="event_id" type="varchar(100)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="processed_at" type="timestamp"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>
</databaseChangeLog>
